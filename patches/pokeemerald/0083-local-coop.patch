+static const u8 *const *PageItems(u8 *count)
+{
+    switch (sPage)
+    {
+        case PAGE_HOST:
+            *count = ARRAY_COUNT(sHostItems);
+            return sHostItems;
+        case PAGE_GUEST:
+            *count = ARRAY_COUNT(sGuestItems);
+            return sGuestItems;
+        default:
+            *count = ARRAY_COUNT(sRootItems);
+            return sRootItems;
+    }
+}
+
+static void Highlight(void)
+{
+    if (sPage == PAGE_CHARACTER)
+    {
+        ClearGpuRegBits(REG_OFFSET_DISPCNT, DISPCNT_WIN0_ON);
+    }
+    else
+    {
+        SetGpuRegBits(REG_OFFSET_DISPCNT, DISPCNT_WIN0_ON);
+        SetGpuReg(REG_OFFSET_WIN0H, WIN_RANGE(8, 232));
+        SetGpuReg(REG_OFFSET_WIN0V, WIN_RANGE(sSelection * 16 + 40, sSelection * 16 + 56));
+    }
+}
+
+static void DrawFrames(void)
+{
+    FillBgTilemapBufferRect(1, 0x1F0, 1, 0, 1, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F1, 2, 0, 27, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F2, 28, 0, 1, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F3, 1, 1, 1, 2, 7);
+    FillBgTilemapBufferRect(1, 0x1F5, 28, 1, 1, 2, 7);
+    FillBgTilemapBufferRect(1, 0x1F6, 1, 3, 1, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F7, 2, 3, 27, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F8, 28, 3, 1, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F0, 0, 4, 1, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F1, 1, 4, 28, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F2, 29, 4, 1, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F3, 0, 5, 1, 12, 7);
+    FillBgTilemapBufferRect(1, 0x1F5, 29, 5, 1, 12, 7);
+    FillBgTilemapBufferRect(1, 0x1F6, 0, 16, 1, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F7, 1, 16, 28, 1, 7);
+    FillBgTilemapBufferRect(1, 0x1F8, 29, 16, 1, 1, 7);
+    FillBgTilemapBufferRect(1, 0, 0, 17, 30, 4, 0);
+    if (sPage == PAGE_CHARACTER)
+    {
+        FillBgTilemapBufferRect(1, 0x1F0, 0, 17, 1, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F1, 1, 17, 13, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F2, 14, 17, 1, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F3, 0, 18, 1, 2, 7);
+        FillBgTilemapBufferRect(1, 0x1F5, 14, 18, 1, 2, 7);
+        FillBgTilemapBufferRect(1, 0x1F6, 0, 20, 1, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F7, 1, 20, 13, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F8, 14, 20, 1, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F0, 15, 17, 1, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F1, 16, 17, 13, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F2, 29, 17, 1, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F3, 15, 18, 1, 2, 7);
+        FillBgTilemapBufferRect(1, 0x1F5, 29, 18, 1, 2, 7);
+        FillBgTilemapBufferRect(1, 0x1F6, 15, 20, 1, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F7, 16, 20, 13, 1, 7);
+        FillBgTilemapBufferRect(1, 0x1F8, 29, 20, 1, 1, 7);
+    }
+    CopyBgTilemapBufferToVram(1);
+}
+
+static void DrawAll(void)
+{
+    u8 count;
+    const u8 *const *items = PageItems(&count);
+
+    DrawFrames();
+    if (sPage == PAGE_CHARACTER)
+    {
+        FillWindowPixelBuffer(WIN_BOX_PREV, PIXEL_FILL(1));
+        FillWindowPixelBuffer(WIN_BOX_NEXT, PIXEL_FILL(1));
+        AddTextPrinterParameterized(WIN_BOX_PREV, FONT_NORMAL, sBoxPrev, 8, 1, TEXT_SKIP_DRAW, NULL);
+        AddTextPrinterParameterized(WIN_BOX_NEXT, FONT_NORMAL, sBoxNext, 8, 1, TEXT_SKIP_DRAW, NULL);
+        PutWindowTilemap(WIN_BOX_PREV);
+        PutWindowTilemap(WIN_BOX_NEXT);
+        CopyWindowToVram(WIN_BOX_PREV, COPYWIN_FULL);
+        CopyWindowToVram(WIN_BOX_NEXT, COPYWIN_FULL);
+    }
+    else
+    {
+        ClearWindowTilemap(WIN_BOX_PREV);
+        ClearWindowTilemap(WIN_BOX_NEXT);
+    }
+    FillWindowPixelBuffer(WIN_HEADER, PIXEL_FILL(1));
+    AddTextPrinterParameterized(WIN_HEADER, FONT_NORMAL, PageTitle(), 8, 1, TEXT_SKIP_DRAW, NULL);
+    CopyWindowToVram(WIN_HEADER, COPYWIN_FULL);
+    FillWindowPixelBuffer(WIN_OPTIONS, PIXEL_FILL(1));
+    if (sPage == PAGE_PASSWORD)
+    {
+        for (u8 i = 0; i < CTR_COOP_PASSWORD_LENGTH; i++)
+        {
+            if (i < sPasswordCount)
+                AddTextPrinterParameterized(WIN_OPTIONS, FONT_NORMAL, PASSWORD_LABELS[sPassword[i]], 8 + i * 48, 1, TEXT_SKIP_DRAW, NULL);
+            else
+                AddTextPrinterParameterized(WIN_OPTIONS, FONT_NORMAL, sEmpty, 8 + i * 48, 1, TEXT_SKIP_DRAW, NULL);
+        }
+        AddTextPrinterParameterized(WIN_OPTIONS, FONT_NORMAL, PASSWORD_HELP_TEXT, 8, 65, TEXT_SKIP_DRAW, NULL);
+        AddTextPrinterParameterized(WIN_OPTIONS, FONT_NORMAL, SELECT_BACK_TEXT, 8, 97, TEXT_SKIP_DRAW, NULL);
+    }
+    else if (sPage == PAGE_CHARACTER)
+    {
+        Highlight();
+    }
+    else
+    {
+        for (u8 i = 0; i < count; i++)
+            AddTextPrinterParameterized(WIN_OPTIONS, FONT_NORMAL, items[i], 8, i * 16 + 1, TEXT_SKIP_DRAW, NULL);
+        Highlight();
+    }
+    CopyWindowToVram(WIN_OPTIONS, COPYWIN_FULL);
+}
+
+static void UpdateCursor(void)
+{
+    if (sPage != PAGE_CHARACTER)
+    {
+        if (sCursorSpriteId != MAX_SPRITES)
+            DestroySprite(&gSprites[sCursorSpriteId]);
+        sCursorSpriteId = MAX_SPRITES;
+        return;
+    }
+    u8 x = (sSelection % CHARACTER_COLS) * 30 + 15;
+    u8 y = (sSelection / CHARACTER_COLS) * 40 + 40;
+
+    if (sCursorSpriteId == MAX_SPRITES)
+        sCursorSpriteId = CreateSprite(&sCursorTemplate, x, y, 0);
+    else
+    {
+        gSprites[sCursorSpriteId].x = x;
+        gSprites[sCursorSpriteId].y = y;
+    }
+    if (sCursorSpriteId != MAX_SPRITES)
+        gSprites[sCursorSpriteId].oam.priority = 0;
+    for (u8 i = 0; i < CHARACTER_PAGE_SIZE && sCharacterTop + i < ARRAY_COUNT(sCharacters); i++)
+    {
+        struct Sprite *sprite;
+
+        if (sPreviewSpriteIds[i] == MAX_SPRITES)
+            continue;
+        sprite = &gSprites[sPreviewSpriteIds[i]];
+        if (sCharacterTop + i == sCharacterIndex)
+        {
+            StartSpriteAnimIfDifferent(sprite, ANIM_STD_GO_SOUTH);
+        }
+        else if (sprite->animNum != GetFaceDirectionAnimNum(DIR_SOUTH))
+        {
+            StartSpriteAnim(sprite, GetFaceDirectionAnimNum(DIR_SOUTH));
+            SeekSpriteAnim(sprite, 0);
+        }
+    }
+}
+
+static void DrawPreview(void)
+{
+    if (sPreviewPage == sCharacterTop && sPage == PAGE_CHARACTER)
+    {
+        UpdateCursor();
+        return;
+    }
+    for (u8 i = 0; i < CHARACTER_PAGE_SIZE; i++)
+    {
+        if (sPreviewSpriteIds[i] != MAX_SPRITES)
+            DestroySprite(&gSprites[sPreviewSpriteIds[i]]);
+        sPreviewSpriteIds[i] = MAX_SPRITES;
+    }
+    sPreviewPage = 0xFF;
+    if (sPage == PAGE_CHARACTER)
+    {
+        for (u8 i = 0; i < CHARACTER_PAGE_SIZE && sCharacterTop + i < ARRAY_COUNT(sCharacters); i++)
+        {
+            u8 x = (i % CHARACTER_COLS) * 30 + 15;
+            u8 y = (i / CHARACTER_COLS) * 40 + 64;
+
+            sPreviewSpriteIds[i] = CreateObjectGraphicsSprite(sCharacters[sCharacterTop + i].graphicsId, SpriteCallbackDummy, x, y, 0);
+            if (sPreviewSpriteIds[i] != MAX_SPRITES)
+                gSprites[sPreviewSpriteIds[i]].oam.priority = 0;
+        }
+        sPreviewPage = sCharacterTop;
+    }
+    UpdateCursor();
+}
+
+static void OpenPassword(bool host)
+{
+    sPage = PAGE_PASSWORD;
+    sPasswordForHost = host;
+    sPasswordReturn = NULL;
+    sPasswordCount = 0;
+    memset(sPassword, 0xFF, sizeof(sPassword));
+    DrawPreview();
+    DrawAll();
+}
+
+static void FinishPassword(u8 taskId)
+{
+    if (sPasswordForHost)
+        CtrCoopProfile_SetHostPassword(sPassword);
+    else
+        CtrCoopProfile_SetGuestPassword(sPassword);
+    if (sPasswordReturn)
+    {
+        MainCallback returnCallback = sPasswordReturn;
+
+        sPasswordReturn = NULL;
+        CtrCoop_JoinPrepared();
+        FreeAllWindowBuffers();
+        SetMainCallback2(returnCallback);
+        DestroyTask(taskId);
+        return;
+    }
+    sPage = sPasswordForHost ? PAGE_HOST : PAGE_GUEST;
+    sSelection = sPasswordForHost ? 1 : 2;
+    DrawAll();
+}
+
+static void OpenCharacter(bool host)
+{
+    const struct CtrCoopProfile *profile = CtrCoopProfile_Get();
+
+    sPage = PAGE_CHARACTER;
+    sCharacterForHost = host;
+    sCharacterIndex = 0;
+    for (u8 i = 0; i < ARRAY_COUNT(sCharacters); i++)
+    {
+        u8 current = host ? profile->hostGraphicsId : profile->guestGraphicsId;
+        if (sCharacters[i].graphicsId == current)
+            sCharacterIndex = i;
+    }
+    sCharacterTop = (sCharacterIndex / CHARACTER_PAGE_SIZE) * CHARACTER_PAGE_SIZE;
+    sSelection = sCharacterIndex - sCharacterTop;
+    DrawPreview();
+    DrawAll();
+}
+
+static void FinishCharacter(void)
+{
+    if (sCharacterForHost)
+    {
+        CtrCoopProfile_SetHostGraphicsId(sCharacters[sCharacterIndex].graphicsId);
+        sPage = PAGE_HOST;
+        sSelection = 0;
+    }
+    else
+    {
+        CtrCoopProfile_SetGuestGraphicsId(sCharacters[sCharacterIndex].graphicsId);
+        sPage = PAGE_GUEST;
+        sSelection = 0;
+    }
+    DrawPreview();
+    DrawAll();
+}
+
+static void SwitchBox(int direction)
+{
+    u8 pageCount = (ARRAY_COUNT(sCharacters) + CHARACTER_PAGE_SIZE - 1) / CHARACTER_PAGE_SIZE;
+    u8 page = sCharacterTop / CHARACTER_PAGE_SIZE;
+
+    page = (page + direction + pageCount) % pageCount;
+    sCharacterTop = page * CHARACTER_PAGE_SIZE;
+    sCharacterIndex = sCharacterTop + sSelection;
+    if (sCharacterIndex >= ARRAY_COUNT(sCharacters))
+        sCharacterIndex = ARRAY_COUNT(sCharacters) - 1;
+    DrawPreview();
+    DrawAll();
+}
+
+static void ExitMenu(u8 taskId)
+{
+    FreeAllWindowBuffers();
+    SetMainCallback2(gMain.savedCallback);
+    DestroyTask(taskId);
+}
+
+static void CB2_ReturnFromGuestNaming(void)
+{
+    CtrCoopProfile_SetGuestName(sGuestName, StringLength(sGuestName));
+    sPage = PAGE_GUEST;
+    sSelection = 1;
+    CB2_InitMultiplayerMenu();
+}
+
+static void StartGuestNaming(u8 taskId)
+{
+    const struct CtrCoopProfile *profile = CtrCoopProfile_Get();
+
+    memset(sGuestName, EOS, sizeof(sGuestName));
+    memcpy(sGuestName, profile->guestName, profile->guestNameLength);
+    DoNamingScreen(NAMING_SCREEN_PLAYER, sGuestName, 0, 0, 0, CB2_ReturnFromGuestNaming);
+    FreeAllWindowBuffers();
+    DestroyTask(taskId);
+}
+
+static void ActivateItem(u8 taskId)
+{
+    if (sPage == PAGE_ROOT)
+    {
+        if (sSelection == 0)
+            sPage = PAGE_HOST;
+        else if (sSelection == 1)
+            sPage = PAGE_GUEST;
+        else
+        {
+            ExitMenu(taskId);
+            return;
+        }
+        sSelection = 0;
+    }
+    else if (sPage == PAGE_HOST)
+    {
+        if (sSelection == 0)
+        {
+            OpenCharacter(TRUE);
+            return;
+        }
+        if (sSelection == 1)
+        {
+            OpenPassword(TRUE);
+            return;
+        }
+        sPage = PAGE_ROOT;
+        sSelection = 0;
+    }
+    else if (sPage == PAGE_GUEST)
+    {
+        if (sSelection == 0)
+        {
+            OpenCharacter(FALSE);
+            return;
+        }
+        if (sSelection == 1)
+        {
+            StartGuestNaming(taskId);
+            return;
+        }
+        if (sSelection == 2)
+        {
+            OpenPassword(FALSE);
+            return;
+        }
+        sPage = PAGE_ROOT;
+        sSelection = 1;
+    }
+    DrawPreview();
+    DrawAll();
+}
+
+static void Task_MultiplayerInput(u8 taskId)
+{
+    if (gPaletteFade.active)
+        return;
+    if (sPage == PAGE_PASSWORD)
+    {
+        u8 button = 0xFF;
+        u16 keys = JOY_NEW(A_BUTTON | B_BUTTON | DPAD_UP | DPAD_DOWN | DPAD_LEFT | DPAD_RIGHT | L_BUTTON | R_BUTTON);
+        u16 nativeKeys = CtrInput_Get()->physicalDown;
+
+        if (JOY_NEW(SELECT_BUTTON))
+        {
+            if (sPasswordReturn)
+            {
+                MainCallback returnCallback = sPasswordReturn;
+
+                sPasswordReturn = NULL;
+                FreeAllWindowBuffers();
+                SetMainCallback2(returnCallback);
+                DestroyTask(taskId);
+            }
+            else
+            {
+                sPage = sPasswordForHost ? PAGE_HOST : PAGE_GUEST;
+                sSelection = sPasswordForHost ? 1 : 2;
+                DrawAll();
+            }
+            return;
+        }
+        if (keys & A_BUTTON) button = 0;
+        else if (keys & B_BUTTON) button = 1;
+        else if (nativeKeys & CTR_KEY_X) button = 2;
+        else if (nativeKeys & CTR_KEY_Y) button = 3;
+        else if (keys & DPAD_UP) button = 4;
+        else if (keys & DPAD_DOWN) button = 5;
+        else if (keys & DPAD_LEFT) button = 6;
+        else if (keys & DPAD_RIGHT) button = 7;
+        else if (keys & L_BUTTON) button = 8;
+        else if (keys & R_BUTTON) button = 9;
+        if (button != 0xFF)
+        {
+            PlaySE(SE_SELECT);
+            sPassword[sPasswordCount++] = button;
+            if (sPasswordCount == CTR_COOP_PASSWORD_LENGTH)
+                FinishPassword(taskId);
+            else
+                DrawAll();
+        }
+        return;
+    }
+    if (sPage == PAGE_CHARACTER)
+    {
+        int delta = 0;
+
+        if (JOY_NEW(L_BUTTON))
+        {
+            SwitchBox(-1);
+            return;
+        }
+        if (JOY_NEW(R_BUTTON))
+        {
+            SwitchBox(1);
+            return;
+        }
+        if (JOY_NEW(DPAD_UP))
+            delta = -CHARACTER_COLS;
+        else if (JOY_NEW(DPAD_DOWN))
+            delta = CHARACTER_COLS;
+        else if (JOY_NEW(DPAD_LEFT))
+            delta = -1;
+        else if (JOY_NEW(DPAD_RIGHT))
+            delta = 1;
+        if (delta)
+        {
+            sCharacterIndex = (sCharacterIndex + delta + ARRAY_COUNT(sCharacters)) % ARRAY_COUNT(sCharacters);
+            sCharacterTop = (sCharacterIndex / CHARACTER_PAGE_SIZE) * CHARACTER_PAGE_SIZE;
+            sSelection = sCharacterIndex - sCharacterTop;
+            DrawPreview();
+            DrawAll();
+        }
+        else if (JOY_NEW(A_BUTTON))
+            FinishCharacter();
+        else if (JOY_NEW(B_BUTTON))
+        {
+            sPage = sCharacterForHost ? PAGE_HOST : PAGE_GUEST;
+            sSelection = 0;
+            DrawPreview();
+            DrawAll();
+        }
+        return;
+    }
+    if (JOY_NEW(A_BUTTON))
+    {
+        PlaySE(SE_SELECT);
+        ActivateItem(taskId);
+    }
+    else if (JOY_NEW(B_BUTTON))
+    {
+        if (sPage == PAGE_ROOT)
+            ExitMenu(taskId);
+        else
+        {
+            sSelection = sPage == PAGE_HOST ? 0 : 1;
+            sPage = PAGE_ROOT;
+            DrawAll();
+        }
+    }
+    else if (JOY_NEW(DPAD_UP))
+    {
+        u8 count;
+        PageItems(&count);
+        sSelection = (sSelection + count - 1) % count;
+        Highlight();
+    }
+    else if (JOY_NEW(DPAD_DOWN))
+    {
+        u8 count;
+        PageItems(&count);
+        sSelection = (sSelection + 1) % count;
+        Highlight();
+    }
+}
+
+void CB2_InitMultiplayerMenu(void)
+{
+    sPreviewPage = 0xFF;
+    sCursorSpriteId = MAX_SPRITES;
+    for (u8 i = 0; i < CHARACTER_PAGE_SIZE; i++)
+        sPreviewSpriteIds[i] = MAX_SPRITES;
+    SetVBlankCallback(NULL);
+    SetGpuReg(REG_OFFSET_DISPCNT, 0);
+    DmaClearLarge16(3, (void *)VRAM, VRAM_SIZE, 0x1000);
+    DmaClear32(3, OAM, OAM_SIZE);
+    DmaClear16(3, PLTT, PLTT_SIZE);
+    ResetPaletteFade();
+    ScanlineEffect_Stop();
+    ResetTasks();
+    ResetSpriteData();
+    FreeAllSpritePalettes();
+    LoadSpriteSheet(&sCursorSheet);
+    LoadSpritePalette(&sCursorPalette);
+    ResetBgsAndClearDma3BusyFlags(0);
+    InitBgsFromTemplates(0, sBgTemplates, ARRAY_COUNT(sBgTemplates));
+    ChangeBgX(0, 0, BG_COORD_SET);
+    ChangeBgY(0, 0, BG_COORD_SET);
+    ChangeBgX(1, 0, BG_COORD_SET);
+    ChangeBgY(1, 0, BG_COORD_SET);
+    InitWindows(sWindowTemplates);
+    DeactivateAllTextPrinters();
+    LoadBgTiles(1, GetWindowFrameTilesPal(gSaveBlock2Ptr->optionsWindowFrameType)->tiles, 0x120, 0x1F0);
+    LoadPalette(sBackgroundPalette, BG_PLTT_ID(0), sizeof(sBackgroundPalette));
+    LoadPalette(GetWindowFrameTilesPal(gSaveBlock2Ptr->optionsWindowFrameType)->pal, BG_PLTT_ID(7), PLTT_SIZE_4BPP);
+    LoadPalette(sTextPalette, BG_PLTT_ID(1), sizeof(sTextPalette));
+    SetGpuReg(REG_OFFSET_WIN0H, 0);
+    SetGpuReg(REG_OFFSET_WIN0V, 0);
+    SetGpuReg(REG_OFFSET_WININ, WININ_WIN0_BG0 | WININ_WIN0_OBJ);
+    SetGpuReg(REG_OFFSET_WINOUT, WINOUT_WIN01_BG0 | WINOUT_WIN01_BG1 | WINOUT_WIN01_OBJ | WINOUT_WIN01_CLR);
+    SetGpuReg(REG_OFFSET_BLDCNT, BLDCNT_TGT1_BG0 | BLDCNT_EFFECT_DARKEN);
+    SetGpuReg(REG_OFFSET_BLDALPHA, 0);
+    SetGpuReg(REG_OFFSET_BLDY, 4);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_WIN0_ON | DISPCNT_OBJ_ON | DISPCNT_OBJ_1D_MAP);
+    ShowBg(0);
+    ShowBg(1);
+    PutWindowTilemap(WIN_HEADER);
+    PutWindowTilemap(WIN_OPTIONS);
+    DrawFrames();
+    DrawAll();
+    BeginNormalPaletteFade(PALETTES_ALL, 0, 16, 0, RGB_BLACK);
+    SetVBlankCallback(MultiplayerVBlank);
+    SetMainCallback2(MultiplayerMain);
+    CreateTask(Task_MultiplayerInput, 0);
+}
+
+void CB2_InitMultiplayerGuestPassword(void)
+{
+    sPasswordReturn = gMain.savedCallback;
+    sPage = PAGE_PASSWORD;
+    sPasswordForHost = FALSE;
+    sPasswordCount = 0;
+    memset(sPassword, 0xFF, sizeof(sPassword));
+    CB2_InitMultiplayerMenu();
+}
+#endif
