+void CtrCoop_CommitIntroHealthboxes(void)
+{
+    u32 battler;
+
+    if (!sCoopIntroHealthboxesPending || !CtrCoop_IsDoubleBattle())
+        return;
+    sCoopIntroHealthboxesPending = FALSE;
+    // CHOOSEACTION follows every intro completion on both endpoints. Use
+    // the same native reconstruction that restores both boxes after a menu,
+    // after the trainer/ball/shiny sprite lifetimes have all finished.
+    for (battler = 0; battler < gBattlersCount; battler++)
+    {
+        u8 id = gHealthboxSpriteIds[battler];
