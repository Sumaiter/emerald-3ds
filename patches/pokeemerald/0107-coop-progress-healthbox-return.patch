+u8 CtrCoop_EnginePrepareEvolutionParty(u8 levelBits)
+{
+    u32 i;
+    u8 fullLevelBits = 0;
+
+    sCoopEvolutionPartyFull = FALSE;
+    sCoopEvolutionPartySelected = FALSE;
+    if (!CtrCoop_IsDoubleInitiator())
+        return levelBits;
+    if (!sRoute101TestPartyActive)
+    {
+        if (!CtrCoop_IsStoryPartnerBattle()
+         || gBattleScripting.specialTrainerBattleType != SPECIAL_BATTLE_STEVEN)
+            return levelBits;
+        sCoopEvolutionPartySelected = TRUE;
+    }
+    // These authored encounters replaced the reserves before coop setup.
+    // Their native full-party RAM backup is the owner's canonical basis.
+    for (i = 0; i < MULTI_PARTY_SIZE; i++)
+    {
+        u8 slot = sCoopEvolutionPartySelected
+            ? gSaveBlock2Ptr->frontier.selectedPartyMons[i] - 1 : (s32)i;
+        if (slot < PARTY_SIZE)
+        {
+            gSaveBlock1Ptr->playerParty[slot] = gPlayerParty[i];
+            if (levelBits & (1 << i))
+                fullLevelBits |= 1 << slot;
+        }
+    }
+    memcpy(gPlayerParty, gSaveBlock1Ptr->playerParty, sizeof(gPlayerParty));
+    gPlayerPartyCount = CalculatePlayerPartyCount();
+    sCoopEvolutionPartyFull = TRUE;
+    return fullLevelBits;
+}
+
+void CtrCoop_EngineFinishEvolutionParty(void)
+{
+    u32 i;
+
+    if (!sCoopEvolutionPartyFull)
+        return;
+    sCoopEvolutionPartyFull = FALSE;
+    // Preserve evolved mons and a possible Shedinja before the encounter's
+    // native callback/script restores the temporary party a second time.
+    SavePlayerParty();
+    if (sCoopEvolutionPartySelected)
+    {
+        // frontier_saveparty still expects selected mons in compact order.
+        // It writes them to the same saved slots, leaving new/reserve mons.
+        for (i = 0; i < PARTY_SIZE; i++)
+            ZeroMonData(&gPlayerParty[i]);
+        for (i = 0; i < MULTI_PARTY_SIZE; i++)
+        {
+            u8 slot = gSaveBlock2Ptr->frontier.selectedPartyMons[i] - 1;
+            if (slot < PARTY_SIZE)
+                gPlayerParty[i] = gSaveBlock1Ptr->playerParty[slot];
+        }
+        gPlayerPartyCount = CalculatePlayerPartyCount();
+    }
+    sCoopEvolutionPartySelected = FALSE;
+}
+#endif
