 #ifdef PLATFORM_3DS
+void CtrCoop_EngineRemoveRemoteObject(u8 objectEventId)
+{
+    struct ObjectEvent *object;
+    if (objectEventId >= OBJECT_EVENTS_COUNT)
+        return;
+    object = &gObjectEvents[objectEventId];
+    if (!object->active || object->isPlayer || object->localId != LOCALID_COOP_PLAYER)
+        return;
+    // This session-only actor has no script flag or story removal to publish.
+    // Menus can reuse its sprite slot; never destroy another sprite's storage.
+    if (object->spriteId < MAX_SPRITES && gSprites[object->spriteId].inUse
+     && gSprites[object->spriteId].data[0] == objectEventId)
+        RemoveObjectEvent(object);
+    else
+        object->active = FALSE;
+}
