+#ifdef PLATFORM_3DS
+void CtrCoop_EmitPartyProgress(u8 partyId)
+{
+    sBattleBuffersTransferData[0] = CONTROLLER_SETRAWMONDATA;
+    sBattleBuffersTransferData[1] = 0xFF; // cooperative full-party-slot record
+    sBattleBuffersTransferData[2] = sizeof(struct Pokemon);
