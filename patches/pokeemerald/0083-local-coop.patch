+    SetVBlankCallback(VBlankCB_MainMenu);
+    SetMainCallback2(CB2_MainMenu);
+    SetGpuReg(REG_OFFSET_DISPCNT, DISPCNT_WIN0_ON | DISPCNT_OBJ_ON | DISPCNT_OBJ_1D_MAP);
+    ShowBg(0);
+    HideBg(1);
+    for (u8 i = 0; i < 5; i++)
+    {
+        JoinGamePrint(i, sJoinEmpty);
+        DrawMainMenuWindowBorder(&sWindowTemplates_JoinMenu[i], MAIN_MENU_BORDER_TILE);
+    }
+    CopyBgTilemapBufferToVram(0);
+    JoinGamePrint(0, JOIN_SEARCH_DOTS[0]);
+    JoinGamePrint(1, JOIN_BACK_TEXT);
+    SetGpuReg(REG_OFFSET_WIN0H, MENU_WIN_HCOORDS);
+    SetGpuReg(REG_OFFSET_WIN0V, MENU_WIN_VCOORDS(8));
+    CreateTask(Task_JoinGameSearch, 0);
+}
+
+static void JoinGameHighlight(u8 selected)
+{
+    switch (selected)
+    {
+        case 0:
+            SetGpuReg(REG_OFFSET_WIN0V, MENU_WIN_VCOORDS(8));
+            break;
+        case 1:
+            SetGpuReg(REG_OFFSET_WIN0V, MENU_WIN_VCOORDS(1));
+            break;
+        case 2:
+            SetGpuReg(REG_OFFSET_WIN0V, MENU_WIN_VCOORDS(4));
+            break;
+        default:
+            SetGpuReg(REG_OFFSET_WIN0V, MENU_WIN_VCOORDS(5));
+            break;
+    }
+}
+
+static void OpenJoinPassword(u8 taskId)
+{
+    gMain.savedCallback = InitJoinGameMenu;
+    SetMainCallback2(CB2_InitMultiplayerGuestPassword);
+    DestroyTask(taskId);
+}
+
+static void JoinSelectedGame(u8 taskId, uint32_t token)
+{
+    gTasks[taskId].data[6] = 1;
+    CtrCoop_PrepareJoin(token);
+    if (CtrCoopProfile_HasGuestPassword())
+        CtrCoop_JoinGame(token, CtrCoopProfile_Get()->guestPassword);
+    else
+        OpenJoinPassword(taskId);
+}
+
+static void ContinueJoinedGame(void)
+{
+    CtrCoop_EnterHostWorld();
+    CB2_ContinueSavedGame();
+    InitMap();
+}
+
+static void Task_JoinGameSearch(u8 taskId)
+{
+    struct CtrCoopFoundGame games[3];
+    u8 state;
+
+    CtrCoop_MenuFrame();
+    state = CtrCoop_GetSessionState();
+    u8 selected = gTasks[taskId].data[5];
+    int found = CtrCoop_GetFoundGames(games, ARRAY_COUNT(games));
+
+    if (selected > found)
+        selected = found;
+    if (JOY_NEW(B_BUTTON))
+    {
+        CtrCoop_Stop();
+        InitMainMenu(FALSE);
+        return;
+    }
+    if (state == LOCAL_SESSION_AUTH_FAILED)
+    {
+        OpenJoinPassword(taskId);
+        return;
+    }
+    if (state == LOCAL_SESSION_IN && gSaveFileStatus != SAVE_STATUS_EMPTY && gSaveFileStatus != SAVE_STATUS_NO_FLASH)
+    {
+        gPlttBufferUnfaded[0] = RGB_BLACK;
+        gPlttBufferFaded[0] = RGB_BLACK;
+        SetMainCallback2(ContinueJoinedGame);
+        DestroyTask(taskId);
+        return;
+    }
+    if (state != LOCAL_SESSION_IN && gTasks[taskId].data[6] == 0)
+    {
+        if (JOY_NEW(DPAD_UP) && selected > 0)
+            selected--;
+        else if (JOY_NEW(DPAD_DOWN) && selected < found)
+            selected++;
+        if (JOY_NEW(A_BUTTON))
+        {
+            if (selected == 0)
+            {
+                CtrCoop_Stop();
+                InitMainMenu(FALSE);
+                return;
+            }
+            JoinSelectedGame(taskId, games[selected - 1].token);
+        }
+    }
+    gTasks[taskId].data[5] = selected;
+    JoinGameHighlight(selected);
+    if (state == LOCAL_SESSION_NONE)
+        CtrCoop_Search();
+    if (++gTasks[taskId].data[2] < 20)
+        return;
+    gTasks[taskId].data[2] = 0;
+    gTasks[taskId].data[3] = (gTasks[taskId].data[3] + 1) % 4;
+    if (state == LOCAL_SESSION_IN)
+        JoinGamePrint(0, JOIN_CONNECTED_TEXT);
+    else if (state == LOCAL_SESSION_FAILED || state == LOCAL_SESSION_OFF)
+        JoinGamePrint(0, JOIN_FAILED_TEXT);
+    else if (state == LOCAL_SESSION_OTHER_BUILD)
+        JoinGamePrint(0, JOIN_OTHER_BUILD_TEXT);
+    else
+        JoinGamePrint(0, JOIN_SEARCH_DOTS[gTasks[taskId].data[3]]);
+    if (found)
+        gTasks[taskId].data[4] = 0;
+    else if (gTasks[taskId].data[4] < 600)
+        gTasks[taskId].data[4] += 20;
+    for (u8 i = 0; i < ARRAY_COUNT(games); i++)
+    {
+        if (i < found)
+        {
+            static const u8 version[] = _(" V" CTR_COOP_VERSION);
+            const u8 *name = games[i].hostName;
+            const u8 *suffix = version;
+            u8 label[24];
+            u8 *out = label;
+
+            while (*name != EOS)
+                *out++ = *name++;
+            while (*suffix != EOS)
+                *out++ = *suffix++;
+            *out = EOS;
+            JoinGamePrint(i + 2, label);
+        }
+        else if (!found && gTasks[taskId].data[4] >= 600)
+            JoinGamePrint(i + 2, JOIN_HINTS[i]);
         else
-            sCurrItemAndOptionMenuCheck |= OPTION_MENU_FLAG;  // entering the options menu
+            JoinGamePrint(i + 2, sJoinEmpty);
     }
 }
+#endif
 
