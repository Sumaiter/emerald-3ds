diff --git a/data/maps/Route101/scripts.inc b/data/maps/Route101/scripts.inc
--- a/data/maps/Route101/scripts.inc
+++ b/data/maps/Route101/scripts.inc
@@ -1,3 +1,62 @@
+@ Repeatable fixtures: no normal trainer or story flags are reused.
+Route101_EventScript_TestDouble::
+    lock
+    faceplayer
+    msgbox Route101_Text_TestDouble, MSGBOX_YESNO
+    goto_if_eq VAR_RESULT, NO, Route101_EventScript_TestEnd
+    setvar VAR_0x8004, 0
+    goto Route101_EventScript_TestStart
+
+Route101_EventScript_TestPartner::
+    lock
+    faceplayer
+    msgbox Route101_Text_TestPartner, MSGBOX_YESNO
+    goto_if_eq VAR_RESULT, NO, Route101_EventScript_TestEnd
+    setvar VAR_0x8004, 1
+
+Route101_EventScript_TestStart::
+    closemessage
+    specialvar VAR_RESULT, Route101_StartTestBattle
+    goto_if_eq VAR_RESULT, FALSE, Route101_EventScript_TestNotReady
+    waitstate
+    msgbox Route101_Text_TestAgain, MSGBOX_DEFAULT
+Route101_EventScript_TestEnd::
+    release
+    end
+
+Route101_EventScript_TestNotReady::
+    msgbox Route101_Text_TestNotReady, MSGBOX_DEFAULT
+    goto Route101_EventScript_TestEnd
+
+Route101_Text_TestDouble:
+    .string "TEST A: Doppelkampf ohne NPC-Partner.\n"
+    .string "Meine vier POKEMON sind auf Level 5.\p"
+    .string "Im Koop zuerst dem Spieler folgen,\n"
+    .string "dann spricht der Anfuehrer mich an.\p"
+    .string "Du brauchst zwei kampffaehige\n"
+    .string "POKEMON auf den ersten drei Plaetzen.\p"
+    .string "Der Test ist beliebig wiederholbar.\n"
+    .string "Moechtest du jetzt kaempfen?$"
+
+Route101_Text_TestPartner:
+    .string "TEST B: Doppelkampf mit NPC-Partner.\n"
+    .string "Ich helfe mit drei POKEMON auf Lv. 5.\p"
+    .string "Im Koop steuert der Folgespieler\n"
+    .string "mein STOLLUNIOR, PUPPANCE und TANHEL.\p"
+    .string "Sein eigenes Team bleibt unveraendert.\n"
+    .string "Du kaempfst mit deinen ersten drei.\p"
+    .string "Mindestens eines muss kampffaehig sein.\n"
+    .string "Moechtest du jetzt kaempfen?$"
+
+Route101_Text_TestAgain:
+    .string "Test beendet. Sprich mich wieder an,\n"
+    .string "wenn du erneut testen willst.$"
+
+Route101_Text_TestNotReady:
+    .string "Bitte zuerst POKEMON heilen.\n"
+    .string "TEST A braucht zwei, TEST B eines\l"
+    .string "auf den ersten drei Teamplaetzen.$"
+
 Route101_MapScripts::
 	map_script MAP_SCRIPT_ON_TRANSITION, Route101_OnTransition
 	map_script MAP_SCRIPT_ON_FRAME_TABLE, Route101_OnFrame
