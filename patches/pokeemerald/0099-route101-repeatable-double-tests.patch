+
+static const u8 sRoute101TestDefeated[] = _("Der Test ist beendet! Bereit fuer mehr?");
+
+static void CB2_EndRoute101TestBattle(void)
+{
+    u32 i;
+
+    if (gBattleTypeFlags & BATTLE_TYPE_INGAME_PARTNER)
+    {
+        // Keep the leader's real combat changes, restore reserves verbatim,
+        // and discard the temporary NPC triplet before any co-op result/save.
+        for (i = 0; i < MULTI_PARTY_SIZE; i++)
+            gSaveBlock1Ptr->playerParty[i] = gPlayerParty[i];
+        LoadPlayerParty();
+    }
+
+    if (IsPlayerDefeated(gBattleOutcome))
+        SetMainCallback2(CB2_WhiteOut);
+    else
+    {
+#ifdef PLATFORM_3DS
+        CtrCoop_BattleEnd();
+#endif
+        SetMainCallback2(CB2_ReturnToFieldContinueScriptPlayMapMusic);
+    }
+}
+
+u16 Route101_StartTestBattle(void)
+{
+    static const u16 partnerSpecies[MULTI_PARTY_SIZE] = {
+        SPECIES_ARON, SPECIES_BALTOY, SPECIES_BELDUM,
+    };
+    bool8 withPartner = gSpecialVar_0x8004 == 1;
+    u32 i, alive = 0;
+
+    if (gSpecialVar_0x8004 > 1)
+        return FALSE;
+    for (i = 0; i < MULTI_PARTY_SIZE; i++)
+    {
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES)
+         && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG)
+         && GetMonData(&gPlayerParty[i], MON_DATA_HP))
+            alive++;
+    }
+    if (alive < (withPartner ? 1 : 2))
+        return FALSE;
+
+    gApproachingTrainerId = 0;
+    InitTrainerBattleVariables();
+    gApproachingTrainerId = 1;
+    InitTrainerBattleVariables();
+    gApproachingTrainerId = 0;
+    sTrainerADefeatSpeech = (u8 *)sRoute101TestDefeated;
+    sTrainerBDefeatSpeech = (u8 *)sRoute101TestDefeated;
+    sNoOfPossibleTrainerRetScripts = 0;
+    sShouldCheckTrainerBScript = FALSE;
+    gNoOfApproachingTrainers = 0;
+    gWhichTrainerToFaceAfterBattle = 0;
+    gTrainerBattleOpponent_A = withPartner ? TRAINER_ROUTE101_TEST_PARTNER_A : TRAINER_ROUTE101_TEST_DOUBLE;
+    gTrainerBattleOpponent_B = withPartner ? TRAINER_ROUTE101_TEST_PARTNER_B : TRAINER_NONE;
+    // Only these dedicated fixture flags are reset; no real story progress.
+    FlagClear(TRAINER_FLAGS_START + gTrainerBattleOpponent_A);
+    if (withPartner)
+        FlagClear(TRAINER_FLAGS_START + gTrainerBattleOpponent_B);
+    gBattleTypeFlags = BATTLE_TYPE_TRAINER | BATTLE_TYPE_DOUBLE;
+    gPartnerTrainerId = 0;
+    gBattleScripting.specialTrainerBattleType = 0;
+    if (withPartner)
+    {
+        SavePlayerParty();
+        for (i = 0; i < MULTI_PARTY_SIZE; i++)
+        {
+            CreateMon(&gPlayerParty[MULTI_PARTY_SIZE + i], partnerSpecies[i],
+                      5, 0, FALSE, 0, OT_ID_PRESET, 61226);
+            SetMonData(&gPlayerParty[MULTI_PARTY_SIZE + i], MON_DATA_OT_NAME,
+                       gTrainers[TRAINER_STEVEN].trainerName);
+        }
+        // The NPC owns slots 3..5 even if the player's first triplet has gaps.
+        gPlayerPartyCount = PARTY_SIZE;
+        gPartnerTrainerId = TRAINER_STEVEN_PARTNER;
+        gBattleScripting.specialTrainerBattleType = SPECIAL_BATTLE_STEVEN;
+        gBattleTypeFlags |= BATTLE_TYPE_MULTI | BATTLE_TYPE_TWO_OPPONENTS | BATTLE_TYPE_INGAME_PARTNER;
+    }
+    LockPlayerFieldControls();
+    FreezeObjectEvents();
+    StopPlayerAvatar();
+    gMain.savedCallback = CB2_EndRoute101TestBattle;
+    DoTrainerBattle();
+    return TRUE;
+}
