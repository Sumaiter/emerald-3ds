+
+bool8 CtrCoop_ApplyPartyProgress(void)
+{
+    u8 monId = gBattleBufferA[gActiveBattler][3];
+    u32 battler, slot;
+    struct Pokemon *mon;
+    if (!CtrCoop_IsDoubleBattle() || gBattleBufferA[gActiveBattler][1] != 0xFF)
+        return FALSE;
+    if (monId >= PARTY_SIZE || gBattleBufferA[gActiveBattler][2] != sizeof(struct Pokemon))
+        return TRUE;
+    mon = &gPlayerParty[monId];
+    memcpy(mon, gBattleBufferA[gActiveBattler] + 4, sizeof(*mon));
+    for (battler = 0; battler < MAX_BATTLERS_COUNT; battler += 2)
+    {
+        struct BattlePokemon *battleMon = &gBattleMons[battler];
+        if (gBattlerPartyIndexes[battler] != monId || !battleMon->hp)
+            continue;
+        battleMon->level = GetMonData(mon, MON_DATA_LEVEL);
+        battleMon->hp = GetMonData(mon, MON_DATA_HP);
+        battleMon->maxHP = GetMonData(mon, MON_DATA_MAX_HP);
+        battleMon->attack = GetMonData(mon, MON_DATA_ATK);
+        battleMon->defense = GetMonData(mon, MON_DATA_DEF);
+        battleMon->speed = GetMonData(mon, MON_DATA_SPEED);
+        battleMon->spAttack = GetMonData(mon, MON_DATA_SPATK);
+        battleMon->spDefense = GetMonData(mon, MON_DATA_SPDEF);
+        for (slot = 0; slot < MAX_MON_MOVES; slot++)
+            if (MOVE_IS_PERMANENT(battler, slot))
+            {
+                // A learned move is permanent; Transform/Mimic stay temporary.
+                battleMon->moves[slot] = GetMonData(mon, MON_DATA_MOVE1 + slot);
+                battleMon->pp[slot] = GetMonData(mon, MON_DATA_PP1 + slot);
+            }
+        battleMon->ppBonuses = GetMonData(mon, MON_DATA_PP_BONUSES);
+    }
+    return TRUE;
+}
+
