+
+void CtrCoop_EngineStoryRefresh(void)
+{
+    u8 i;
+    for (i = 0; i < OBJECT_EVENTS_COUNT; ++i)
+    {
+        struct ObjectEvent *object = &gObjectEvents[i];
+        if (object->active && !object->isPlayer && object->localId != LOCALID_COOP_PLAYER
+         && !CtrCoop_StoryOwnsNpc(object->mapGroup, object->mapNum, object->localId)
+         && !CtrCoop_StoryNpcVisible(object->mapGroup, object->mapNum, object->localId))
+            RemoveObjectEvent(object);
+    }
+}
+
+void CtrCoop_EngineStoryTemplateChanged(u8 localId, u8 fields)
+{
+    u8 i;
+    for (i = 0; i < OBJECT_EVENT_TEMPLATES_COUNT; ++i)
+    {
+        const struct ObjectEventTemplate *object = &gSaveBlock1Ptr->objectEventTemplates[i];
+        if (object->localId == localId)
+        {
+            CtrCoop_StoryObject(gSaveBlock1Ptr->location.mapGroup, gSaveBlock1Ptr->location.mapNum,
+                                 localId, fields, object->x, object->y, object->movementType);
+            break;
+        }
+    }
+}
+
+void CtrCoop_EngineStoryObject(u8 group, u8 num, u8 localId, u8 fields, s16 x, s16 y, u8 movement)
+{
+    u8 i, objectId;
+    bool coordsChanged = false, movementChanged = false;
+    if (group != gSaveBlock1Ptr->location.mapGroup || num != gSaveBlock1Ptr->location.mapNum)
+        return;
+    for (i = 0; i < OBJECT_EVENT_TEMPLATES_COUNT; ++i)
+    {
+        struct ObjectEventTemplate *object = &gSaveBlock1Ptr->objectEventTemplates[i];
+        if (object->localId != localId) continue;
+        if (fields & 1)
+        {
+            coordsChanged = object->x != x || object->y != y;
+            object->x = x; object->y = y;
+        }
+        if ((fields & 2) && movement < NUM_MOVEMENT_TYPES)
+        {
+            movementChanged = object->movementType != movement;
+            object->movementType = movement;
+        }
+        break;
+    }
+    /* Save-template updates are safe during battle/menu callbacks too. Their
+     * sprite arrays are not field objects, so defer all live mutations. */
+    if (fields & 16) return;
+    if (fields & 32)
+    {
+        if (fields & 1) coordsChanged = true;
+        if ((fields & 2) && movement < NUM_MOVEMENT_TYPES) movementChanged = true;
+    }
+    if (TryGetObjectEventIdByLocalIdAndMap(localId, num, group, &objectId))
+    {
+        if (!(fields & 4) || i == OBJECT_EVENT_TEMPLATES_COUNT) return;
+        objectId = TrySpawnObjectEvent(localId, num, group);
+        if (objectId >= OBJECT_EVENTS_COUNT) return;
+    }
+    if (fields & 8)
+    {
+        RemoveObjectEvent(&gObjectEvents[objectId]);
+        return;
+    }
+    if (coordsChanged)
+        MoveObjectEventToMapCoords(&gObjectEvents[objectId], x + MAP_OFFSET, y + MAP_OFFSET);
+    if (movementChanged)
+        SetTrainerMovementType(&gObjectEvents[objectId], movement);
+}
+#endif
 
