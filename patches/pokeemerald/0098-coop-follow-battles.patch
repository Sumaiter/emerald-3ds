+bool CtrCoop_EnginePrepareFollowBattle(void)
+{
+    u8 count, target, i;
+    u8 level = 1;
+    if (gBattleTypeFlags & (BATTLE_TYPE_FRONTIER | BATTLE_TYPE_TRAINER_HILL
+        | BATTLE_TYPE_EREADER_TRAINER | BATTLE_TYPE_SECRET_BASE | BATTLE_TYPE_SAFARI
+        | BATTLE_TYPE_WALLY_TUTORIAL | BATTLE_TYPE_RECORDED))
+        return false;
+    if (!(gBattleTypeFlags & BATTLE_TYPE_TRAINER))
+    {
+        /* The original encounter stays slot zero. A second ordinary wild is
+         * created from the actual land/water table, never cloned. */
+        return CtrCoop_EngineCreateWildPartner();
+    }
+    if (!gTrainerBattleOpponent_A || gTrainerBattleOpponent_A >= TRAINERS_COUNT)
+        return false;
+    CreateNPCTrainerParty(gEnemyParty, gTrainerBattleOpponent_A, TRUE);
+    if (gBattleTypeFlags & BATTLE_TYPE_TWO_OPPONENTS)
+    {
+        if (!gTrainerBattleOpponent_B || gTrainerBattleOpponent_B >= TRAINERS_COUNT)
+            return false;
+        CreateNPCTrainerParty(gEnemyParty + MULTI_PARTY_SIZE, gTrainerBattleOpponent_B, FALSE);
+        return true;
+    }
+    /* Existing authored double/story teams stay exactly as authored. */
+    if (gBattleTypeFlags & BATTLE_TYPE_DOUBLE)
+        return true;
+    count = gTrainers[gTrainerBattleOpponent_A].partySize;
+    target = count * 2;
+    if (target < 2) target = 2;
+    if (target > PARTY_SIZE) target = PARTY_SIZE;
+    for (i = 0; i < count; ++i)
+    {
+        u8 monLevel = GetMonData(&gEnemyParty[i], MON_DATA_LEVEL);
+        if (monLevel > level) level = monLevel;
+    }
+    for (i = 0; count < target && i < 3; ++i)
+    {
+        u16 species = sCoopTrainerAdditions[gTrainerBattleOpponent_A][i];
+        if (!species) break;
+        CreateMon(&gEnemyParty[count++], TRAINER_MON_SPECIES(species), level,
+            GetMonData(&gEnemyParty[0], MON_DATA_HP_IV), FALSE, 0, OT_ID_RANDOM_NO_SHINY, 0);
+    }
+    return count >= 2;
+}
+#endif
