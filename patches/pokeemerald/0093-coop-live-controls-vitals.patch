+     || ArePlayerFieldControlsLocked() || ScriptContext_IsEnabled()
+     || CtrCoop_IsWatching())
+        return false;
+    SaveMapView();
+    status = TrySavingData(gDifferentSaveFile ? SAVE_OVERWRITE_DIFFERENT_FILE : SAVE_NORMAL);
