+
+/* A denied lease has not run the approach script yet: only idle tasks exist. */
+void CancelPendingTrainerApproach(void)
+{
+    u8 i;
+    for (i = 0; i < gNoOfApproachingTrainers; ++i)
+    {
+        u8 id = gApproachingTrainers[i].taskId;
+        if (id < NUM_TASKS && gTasks[id].isActive
+         && gTasks[id].func == Task_RunTrainerSeeFuncList
+         && gTasks[id].tFuncId == TRSEE_NONE)
+            DestroyTask(id);
+    }
+    gNoOfApproachingTrainers = 0;
+    gApproachingTrainerId = 0;
+    gTrainerApproachedPlayer = FALSE;
 }
 
